// BenQ: left
output "HDMI-A-1" {
    scale 1.0
    position x=0 y=0
}

// LG UltraGear: right
output "DP-1" {
    scale 1.0
    position x=1920 y=0

    focus-at-startup
}

// 1
workspace "terminal" {
    open-on-output "DP-1"
}

// 2
workspace "browser" {
    open-on-output "HDMI-A-1"
}

// 3
workspace "chat" {
    open-on-output "DP-1"
}

// 4
workspace "note" {
    open-on-output "DP-1"
}

// 5
workspace "others" {
    open-on-output "DP-1"
}

// 6
workspace "garbage" {
    open-on-output "DP-1"
}
